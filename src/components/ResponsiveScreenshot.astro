---
interface Props {
  webp: string;
  png: string;
  alt: string;
  pictureClass?: string;
  imageClass?: string;
  loading?: "eager" | "lazy";
  usWebp?: string;
  usPng?: string;
  usAlt?: string;
  nonAmericasWebp?: string;
  nonAmericasPng?: string;
  nonAmericasAlt?: string;
  northAmericaWebp?: string;
  northAmericaPng?: string;
  northAmericaAlt?: string;
  anzWebp?: string;
  anzPng?: string;
  anzAlt?: string;
}

const {
  webp,
  png,
  alt,
  pictureClass,
  imageClass,
  loading = "lazy",
  usWebp,
  usPng,
  usAlt,
  nonAmericasWebp,
  nonAmericasPng,
  nonAmericasAlt,
  northAmericaWebp,
  northAmericaPng,
  northAmericaAlt,
  anzWebp,
  anzPng,
  anzAlt,
} = Astro.props;
---

<picture class:list={["responsive-screenshot", pictureClass]}>
  <source type="image/webp" srcset={webp} data-webp-source />
  <img
    src={png}
    alt={alt}
    class={imageClass}
    loading={loading}
    decoding="async"
    data-us-image-src={usWebp}
    data-us-original-src={usPng}
    data-us-image-alt={usAlt}
    data-non-americas-image-src={nonAmericasWebp}
    data-non-americas-original-src={nonAmericasPng}
    data-non-americas-image-alt={nonAmericasAlt}
    data-north-america-image-src={northAmericaWebp}
    data-north-america-original-src={northAmericaPng}
    data-north-america-image-alt={northAmericaAlt}
    data-anz-image-src={anzWebp}
    data-anz-original-src={anzPng}
    data-anz-image-alt={anzAlt}
  />
</picture>
