---
interface Props {
  src: string;
}

const { src } = Astro.props;
---

<div class="phone-case phone-case-feature phone-case-storms">
  <figure class="phone-screen-placeholder storm-map-screen">
    <img
      class="phone-screen-image storm-screen-base"
      src={src}
      alt="Vista Weather storm map showing Hurricane Isaias and Tropical Storm Rachel with their tracks and forecast paths, plus fire markers near Colombia and Brazil"
      loading="lazy"
      decoding="async"
      draggable="false"
    />
  </figure>
</div>

<style>
  .phone-case-storms {
    width: min(100%, 330px);
  }

  .storm-map-screen {
    position: relative;
    margin: 0;
    aspect-ratio: 1206 / 2622;
    overflow: hidden;
    background: #06101b;
  }

  .storm-map-screen .storm-screen-base {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

</style>
