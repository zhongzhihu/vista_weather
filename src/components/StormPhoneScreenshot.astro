interface Props {
  src: string;
}

const { src } = Astro.props;

const markers = [
  { x: 76.41, y: 58.86 },
  { x: 18.23, y: 63.3 },
  { x: 48.91, y: 68.74 },
];
---

<div class="phone-case phone-case-feature phone-case-storms">
  <figure
    class="phone-screen-placeholder storm-map-screen"
  >
    <img
      class="phone-screen-image storm-screen-base"
      src={src}
      alt="Satellite image over North America with observed storm tracks and orange forecast paths"
      loading="lazy"
      decoding="async"
      draggable="false"
    />

    <svg class="storm-screen-leaders" viewBox="0 0 1200 2600" aria-hidden="true">
      <line x1="900" y1="1215" x2="917" y2="1530" />
      <line x1="220" y1="2085" x2="219" y2="1646" />
    </svg>

    {markers.map((marker) => (
      <span
        class="storm-screen-marker"
        style={`left:${marker.x}%;top:${marker.y}%;`}
        aria-hidden="true"
      />
    ))}

    <div class="storm-screen-callout storm-screen-callout-isaias">
      <p class="storm-screen-time">Fri, Oct 9 · 3:00 PM</p>
      <p class="storm-screen-name">Hurricane Isaias</p>
      <p class="storm-screen-detail">Max winds 120 mph<br />Moving N at 17 mph</p>
    </div>

    <div class="storm-screen-callout storm-screen-callout-rachel">
      <p class="storm-screen-time">Fri, Oct 9 · 3:00 PM</p>
      <p class="storm-screen-name">Tropical Storm Rachel</p>
      <p class="storm-screen-detail">Max winds 50 mph<br />Moving NE at 5 mph</p>
    </div>
  </figure>
</div>

<style>
  .phone-case-storms {
    width: min(100%, 330px);
  }

  .storm-map-screen {
    position: relative;
    margin: 0;
    aspect-ratio: 1200 / 2600;
    overflow: hidden;
    background: #06101b;
    container-type: inline-size;
  }

  .storm-map-screen .storm-screen-base {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .storm-screen-leaders {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    overflow: visible;
    pointer-events: none;
  }

  .storm-screen-leaders line {
    stroke: rgba(255, 255, 255, 0.96);
    stroke-width: 5;
    stroke-linecap: round;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.32));
  }

  .storm-screen-marker {
    position: absolute;
    z-index: 2;
    width: 7.1%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: url("/cyclone-icon.svg") center / contain no-repeat;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.24));
  }

  .storm-screen-callout {
    position: absolute;
    z-index: 3;
    box-sizing: border-box;
    width: 43%;
    padding: 2.35cqw 2.55cqw;
    border: 1px solid rgba(12, 25, 43, 0.08);
    border-radius: 2.7cqw;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 0.6cqw 1.5cqw rgba(0, 0, 0, 0.14), 0 1.4cqw 3.2cqw rgba(3, 13, 27, 0.2);
    color: #101828;
    font-family: var(--sans, Arial, sans-serif);
    line-height: 1.32;
  }

  .storm-screen-callout p {
    margin: 0;
  }

  .storm-screen-callout-isaias {
    top: 36%;
    left: 53%;
  }

  .storm-screen-callout-rachel {
    top: 80%;
    left: 4%;
  }

  .storm-screen-time {
    font-size: 3cqw;
    font-weight: 750;
    white-space: nowrap;
  }

  .storm-screen-name {
    margin-top: 0.45cqw !important;
    font-size: 2.9cqw;
    font-weight: 650;
  }

  .storm-screen-detail {
    margin-top: 0.55cqw !important;
    color: #667085;
    font-size: 2.75cqw;
    white-space: nowrap;
  }
</style>
