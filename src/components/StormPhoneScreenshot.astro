---
interface Props {
  src: string;
}

const { src } = Astro.props;
const wildfireIcon = `${import.meta.env.BASE_URL}images/wildfire-sf-symbol.png`;
---

<div class="phone-case phone-case-feature phone-case-storms">
  <figure class="phone-screen-placeholder storm-map-screen">
    <img
      class="phone-screen-image storm-screen-base"
      src={src}
      alt="Vista Weather storm map showing Hurricane Isaias and Tropical Storm Rachel with their tracks and forecast paths, plus fire markers near Colombia and Brazil"
      loading="lazy"
      decoding="async"
      draggable="false"
    />
    <svg
      class="fire-marker-layer"
      viewBox="0 0 1206 2622"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <image class="fire-marker" href={wildfireIcon} x="806" y="1166" width="62" height="62" />
      <image class="fire-marker" href={wildfireIcon} x="916" y="1326" width="62" height="62" />
      <image class="fire-marker" href={wildfireIcon} x="1018" y="1464" width="62" height="62" />
    </svg>
  </figure>
</div>

<style>
  .phone-case-storms {
    width: min(100%, 330px);
  }

  .storm-map-screen {
    position: relative;
    margin: 0;
    aspect-ratio: 1206 / 2622;
    overflow: hidden;
    background: #06101b;
  }

  .storm-map-screen .storm-screen-base {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fire-marker-layer {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .fire-marker {
    filter: drop-shadow(0 0 2.58px #000);
  }

</style>
