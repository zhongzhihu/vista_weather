---
// Shared site hero + navigation. Renders the hero background photo, the shade
// overlay, and the top nav (brand + Support). Page-specific hero content is
// passed via the default slot.
//
// The shade layer and nav are marked `transition:persist` so they stay mounted
// across client-side navigation (Astro View Transitions) — only the slotted
// hero content below actually swaps. The <section> shares a `transition:name`
// so its background photo animates as one continuous element instead of
// reloading.
const baseUrl = import.meta.env.BASE_URL;
const heroPhoto = `${baseUrl}satellite-hero-20261009.jpg`;
const home = baseUrl;
---

<section
  class="vista-hero"
  transition:name="site-hero"
  transition:animate="none"
>
  <img class="vista-hero-photo" src={heroPhoto} alt="" />
  <div class="vista-hero-shade" transition:persist></div>

  <header class="hero-nav" transition:persist="site-nav">
    <a class="brand" href={home}>
      <span class="brand-mark" aria-hidden="true">
        <img src={`${baseUrl.replace(/\/$/, "")}/favicon.webp`} alt="" width="52" height="52" loading="eager" />
      </span>
      <span>Vista Weather</span>
    </a>
  </header>

  <slot />
</section>
