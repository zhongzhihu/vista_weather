---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StoreBadge from "../components/StoreBadge.astro";
import sfNowcastRain from "../images/SF_nowcast_rain_C.png";
import thirtyDayWeatherForecastsCelsius from "../images/30-day-weather-forecasts-celsius.png";
import edenPrairieNowcast from "../images/Edenprairie_C_nowc.png";
import forecastComparison from "../images/forecast_comparison.png";
import garmischAlternatePredictions from "../images/Garmisch_alternate_predictions.png";
import possibleOutcomesUS from "../images/possible-outcomes_en-US.png";
import accurateMapsCelsius from "../images/accurate-maps-en-celsius.png";
import accurateMapsFahrenheit from "../images/accurate-maps-en-fahrenheit.png";
import rainRadar from "../images/rain-radar-live-thunder.png";
import europeRainRadar from "../images/rain-radar-europe-lightning.png";
import mapsScreen from "../images/accurate-maps-screen-island.svg";
import mapsDetailCelsius from "../images/accurate-maps-detail-en-celsius.png";
import mapsDetailFahrenheit from "../images/accurate-maps-detail-en-fahrenheit.png";
import mapsComparisonCelsius from "../images/accurate-maps-comparison-en-celsius.png";
import mapsComparisonFahrenheit from "../images/accurate-maps-comparison-en-fahrenheit.png";
import "../styles/global.css";

const googleFormUrl = import.meta.env.PUBLIC_GOOGLE_FORM_URL;
const googleFormEmailEntry = import.meta.env.PUBLIC_GOOGLE_FORM_EMAIL_ENTRY;

// Feature blocks, presented Acme-style: heading + descriptive text first,
// then a large phone screenshot below. Each block alternates the image side on
// wide screens and stacks text-over-image on mobile.
const features = [
  {
    title: "Minute-by-Minute Rain",
    copy: "See exactly when rain will start, stop, and how intense it will be — down to the minute, for the next 4 hours. Highly accurate with hyper-local precision.",
    image: edenPrairieNowcast,
    alt: "Vista Weather rain nowcast for Eden Prairie",
  },
  {
    title: "Ultra-HD Weather Maps",
    copy: "See the bigger picture with ultra-HD maps. While other apps rely on low-resolution data, we capture the details they miss, delivering more accurate forecasts across cities, valleys, and mountains.",
    image: accurateMapsCelsius,
    usImage: accurateMapsFahrenheit,
    alt: "Detailed temperature map comparing Vista Weather with a lower-detail map",
    standalone: true,
  },
  {
    title: "Rain Radar & Live Lightning",
    copy: "Track rain and storms in real time. See where rain is heading and spot lightning strikes as they happen.",
    image: rainRadar,
    alt: "Live rain radar map showing precipitation bands and lightning strikes across the eastern United States",
  },
  {
    title: "30-Day Forecast",
    copy: "Plan further ahead with daily trends all the way out to a month.",
    image: thirtyDayWeatherForecastsCelsius,
    alt: "Vista Weather 30 day weather forecasts in Celsius",
  },
  {
    title: "Forecast Comparison",
    copy: "Compare NWS, Apple Weather, Foreca, and other trusted sources side by side, so you can see where they agree and where they don't.",
    image: forecastComparison,
    alt: "Vista Weather forecast comparison",
  },
  {
    title: "Possible Outcomes",
    intro: "Weather forecasts are based on multiple predictions.",
    copy: "See how certain the forecast is. View the range of possible outcomes instead of a single number.",
    image: garmischAlternatePredictions,
    alt: "Vista Weather possible temperature outcomes for Paris",
  },
];
---

<Layout>
  <main class="site-shell">
    <Header>
      <div class="hero-content" id="app">
        <div class="hero-copy">
          <h1>All-in-One Weather App</h1>
          <p class="hero-dek">
            Accurate forecasts, ultra-HD weather maps, and minute-by-minute rain forecasts
          </p>
          <div class="hero-actions">
            <StoreBadge kind="ios" soon={false} href="https://apps.apple.com/us/app/id6768575893" />
            <button class="waitlist-button" type="button" data-waitlist-open>
              <span>Join Android waitlist</span>
              <span class="waitlist-button-note">Expected Dec '26</span>
            </button>
          </div>
        </div>

        <div class="hero-phones" aria-label="Vista Weather phone mockups">
          <div class="phone-case phone-case-primary">
            <div class="phone-screen-placeholder">
              <img class="phone-screen-image" src={sfNowcastRain.src} alt="Vista Weather rain nowcast for San Francisco" loading="eager" />
            </div>
          </div>

        </div>
      </div>
      <div class="storm-map" data-storm-map role="group" aria-label="Interactive storm tracks">
        <svg class="storm-map-lines" data-storm-lines aria-hidden="true"></svg>
      </div>
      <!-- Simon's values reflect the latest NHC update available by 1900 UTC (3 PM EDT in New York) on Oct 9, 2026. -->
      <aside class="storm-callouts" aria-label="Storm trajectory details">
        <article class="storm-callout storm-callout-rachel" id="storm-callout-rachel" data-storm-callout="rachel" aria-label="Tropical Storm Rachel details">
          <p class="storm-callout-time">Fri, Oct 9 · <time datetime="2026-10-09T19:00:00Z" data-clock-hour="15" data-clock-minute="0">3:00 PM</time></p>
          <p class="storm-callout-name">Tropical Storm Rachel</p>
          <p class="storm-callout-detail" data-wind-speed data-max-wind-mph="50" data-direction="NE" data-moving-speed-mph="5">Max winds 80 kmh · Moving NE at 10 kmh</p>
        </article>
        <article class="storm-callout storm-callout-isaias" id="storm-callout-isaias" data-storm-callout="isaias" aria-label="Hurricane Isaias details">
          <p class="storm-callout-time">Fri, Oct 9 · <time datetime="2026-10-09T19:00:00Z" data-clock-hour="15" data-clock-minute="0">3:00 PM</time></p>
          <p class="storm-callout-name">Hurricane Isaias</p>
          <p class="storm-callout-detail" data-wind-speed data-max-wind-mph="120" data-direction="N" data-moving-speed-mph="17">Max winds 200 kmh · Moving N at 30 kmh</p>
        </article>
        <article class="storm-callout storm-callout-simon" id="storm-callout-simon" data-storm-callout="simon" aria-label="Hurricane Simon details" hidden>
          <p class="storm-callout-time">Fri, Oct 9 · <time datetime="2026-10-09T19:00:00Z" data-clock-hour="15" data-clock-minute="0">3:00 PM</time></p>
          <p class="storm-callout-name">Hurricane Simon</p>
          <p class="storm-callout-detail" data-wind-speed data-max-wind-mph="100" data-direction="NW" data-moving-speed-mph="2">Max winds 160 kmh · Moving NW at 5 kmh</p>
        </article>
      </aside>
    </Header>

    <section class="features-section" id="features">
      <h2 class="features-title">Advanced Forecast Tools</h2>

      {features.map((feature) => (
        <article class="feature-block">
          <div class="feature-copy">
            <h3>{feature.title}</h3>
            {feature.intro && <p class="feature-intro">{feature.intro}</p>}
            <p>{feature.copy}</p>
            {feature.standalone && (
              <div class="map-detail-accordion">
                <div class="data-sources-action map-detail-action">
                  <button
                    class="data-sources-trigger"
                    type="button"
                    id="maps-detail-toggle"
                    data-maps-detail-toggle
                    aria-expanded="false"
                    aria-controls="maps-detail-panel"
                  >
                    <span>What makes our weather maps more detailed?</span>
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="m5 7.5 5 5 5-5" />
                    </svg>
                  </button>
                </div>
                <div
                  class="map-detail-panel"
                  id="maps-detail-panel"
                  data-maps-detail-panel
                  role="region"
                  aria-labelledby="maps-detail-toggle"
                  hidden
                >
                  <p>
                    Weather services provide forecasts using grids made up of squares, sometimes as small as 1 × 1 km each. The smaller these squares, the more local detail a forecast can capture, including differences in temperature, wind, and precipitation across mountains, valleys, and cities.
                  </p>
                  <p>
                    However, transmitting weather data at its original resolution requires enormous amounts of data. To reduce costs, many weather apps use coarser grids with much larger squares (e.g., 100 × 100 km). They then estimate weather conditions between grid points using a technique called <em>interpolation</em>, making the maps appear more detailed than the underlying data actually is. While this saves data, it results in far less accurate forecasts, especially in cities and areas with complex terrain.
                  </p>
                  <p>
                    Vista Weather takes a different approach. We preserve the original high resolution data provided by weather services, rather than reducing it to coarser grids.
                  </p>
                </div>
              </div>
            )}
          </div>
          <div class:list={["feature-media", { "feature-media-map": feature.standalone }]} aria-hidden="true">
            {feature.standalone ? (
              <div class="feature-map-parts">
                <div class="phone-case phone-case-feature map-phone-mockup">
                  <div class="phone-screen-placeholder map-screen">
                    <img class="phone-screen-image" src={mapsScreen.src} alt="Weather map" loading="lazy" />
                  </div>
                </div>
                <img class="map-part map-detail" src={mapsDetailCelsius.src} data-us-image-src={mapsDetailFahrenheit.src} alt="Detailed weather map close-up" loading="lazy" />
                <img class="map-part map-comparison" src={mapsComparisonCelsius.src} data-us-image-src={mapsComparisonFahrenheit.src} alt="Lower-detail weather map comparison" loading="lazy" />
              </div>
            ) : (
            <div
              class:list={[
                "phone-case",
                "phone-case-feature",
                { "phone-case-feature-radar": feature.title === "Rain Radar & Live Lightning" },
              ]}
            >
              <div class="phone-screen-placeholder">
                <img
                  class="phone-screen-image"
                  src={feature.image.src}
                  alt={feature.alt}
                  data-non-americas-image-src={feature.title === "Rain Radar & Live Lightning" ? europeRainRadar.src : undefined}
                  data-non-americas-image-alt={feature.title === "Rain Radar & Live Lightning" ? "Live rain radar map showing precipitation and lightning over central and northern Europe" : undefined}
                  data-us-image-src={feature.title === "Possible Outcomes" ? possibleOutcomesUS.src : undefined}
                  loading="lazy"
                />
              </div>
              {feature.title === "Rain Radar & Live Lightning" && (
                <div class="radar-alert-annotation" aria-hidden="true">
                  <aside class="radar-alert-card">
                    <div class="radar-alert-copy">
                      <p class="radar-alert-title"><svg class="radar-alert-bolt" viewBox="0 0 28 28" aria-hidden="true">
                        <path class="radar-alert-bolt-shadow" d="M11.914 2.75H18.993L15.094 9.95H19.7L8.722 25.25L12.472 13.55H8.3Z" />
                        <path class="radar-alert-bolt-outline" d="M11.914 2.75H18.993L15.094 9.95H19.7L8.722 25.25L12.472 13.55H8.3Z" />
                        <path class="radar-alert-bolt-fill" d="M11.914 2.75H18.993L15.094 9.95H19.7L8.722 25.25L12.472 13.55H8.3Z" />
                      </svg>Lightning</p>
                      <p class="radar-alert-detail">Recent strikes in<br />the last 30 minutes</p>
                    </div>
                  </aside>
                </div>
              )}
            </div>
            )}
          </div>
        </article>
      ))}
    </section>

    <section class="about-section" id="about">
      <div class="about-grid">
        <div class="about-col">
          <h2 class="forecast-sources-heading">Accurate Weather Forecasts</h2>
          <p>
            Most weather apps rely on just 2-3 local weather models and one generic global model. But fewer sources mean less accurate forecasts, especially for local weather.
          </p>
          <p>
            Vista Weather takes a different approach. We offer full transparency about our sources and give you access to the best in the world. This includes Foreca, consistently ranked among the top weather forecasters by ForecastWatch for its exceptional accuracy in predicting rain, alongside 20 renowned official national weather services.
          </p>
          <p>
            Because proven forecasters and local weather models outperform generic global models.
          </p>
          <div class="data-sources-action">
            <button class="data-sources-trigger" type="button" data-data-sources-toggle aria-expanded="false" aria-controls="data-sources-panel">
              <span>View Data Sources</span>
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="m5 7.5 5 5 5-5" />
              </svg>
            </button>
          </div>
          <div class="data-sources-panel" id="data-sources-panel" data-data-sources-panel hidden>
            <div class="data-sources-body">
              <section class="data-source-section" aria-labelledby="commercial-forecasters-heading">
                <div class="data-source-section-heading">
                  <h3 id="commercial-forecasters-heading">Commercial forecasters</h3>
                </div>
                <div class="data-source-region data-source-commercial-card">
                  <ul>
                    <li><span>Foreca</span></li>
                    <li><span>Apple Weather</span></li>
                  </ul>
                </div>
              </section>

              <section class="data-source-section" aria-labelledby="national-services-heading">
                <div class="data-source-section-heading">
                  <h3 id="national-services-heading">National weather services</h3>
                </div>
                <div class="data-source-regions">
                  <section class="data-source-region" aria-labelledby="north-america-heading">
                    <h4 id="north-america-heading">North America</h4>
                    <ul>
                      <li><span>National Weather Service</span><span class="data-source-country">US</span></li>
                      <li><span>Environment and Climate Change Canada</span><span class="data-source-country">CA</span></li>
                    </ul>
                  </section>
                  <section class="data-source-region data-source-region-europe" aria-labelledby="europe-heading">
                    <h4 id="europe-heading">Europe</h4>
                    <ul>
                      <li><span>Deutscher Wetterdienst</span><span class="data-source-country">DE</span></li>
                      <li><span>GeoSphere Austria</span><span class="data-source-country">AT</span></li>
                      <li><span>MeteoSwiss</span><span class="data-source-country">CH</span></li>
                      <li><span>KNMI</span><span class="data-source-country">NL</span></li>
                      <li><span>KMI / RMI</span><span class="data-source-country">BE</span></li>
                      <li><span>Météo-France</span><span class="data-source-country">FR</span></li>
                      <li><span>Met Office</span><span class="data-source-country">UK</span></li>
                      <li><span>AEMET</span><span class="data-source-country">ES</span></li>
                      <li><span>Met Éireann</span><span class="data-source-country">IE</span></li>
                      <li><span>MET Norway</span><span class="data-source-country">NO</span></li>
                      <li><span>SMHI</span><span class="data-source-country">SE</span></li>
                      <li><span>DMI</span><span class="data-source-country">DK</span></li>
                      <li><span>Ilmatieteen laitos</span><span class="data-source-country">FI</span></li>
                      <li><span>ČHMÚ</span><span class="data-source-country">CZ</span></li>
                      <li><span>LHMT</span><span class="data-source-country">LT</span></li>
                      <li><span>ECMWF (Global model)</span><span class="data-source-country">EU</span></li>
                    </ul>
                  </section>
                  <section class="data-source-region" aria-labelledby="asia-heading">
                    <h4 id="asia-heading">Asia</h4>
                    <ul>
                      <li><span>Japan Meteorological Agency</span><span class="data-source-country">JP</span></li>
                      <li><span>Central Weather Administration</span><span class="data-source-country">TW</span></li>
                      <li><span>Thai Meteorological Department</span><span class="data-source-country">TH</span></li>
                    </ul>
                  </section>
                </div>
              </section>
            </div>
          </div>
        </div>
        <div class="about-col">
          <h2>Designed by a data scientist to deliver clear, powerful, and beautiful forecasts.</h2>
          <p>
            Stunning photography, hyper-local insights, and intuitive tools that help you plan every day with confidence.
          </p>
        </div>
      </div>
    </section>

    <Footer />
  </main>

  <div class="waitlist-modal" data-waitlist-modal hidden>
    <button class="waitlist-backdrop" type="button" aria-label="Close Android waitlist form" data-waitlist-close></button>
    <div
      class="waitlist-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="android-waitlist-title"
    >
      <button class="waitlist-close" type="button" aria-label="Close Android waitlist form" data-waitlist-close>
        <span aria-hidden="true">&times;</span>
      </button>
      <h2 id="android-waitlist-title">Join Android waitlist</h2>
      <p>Enter your email and we will let you know when Vista Weather is ready for Android.</p>
      <form
        class="waitlist-form"
        action={googleFormUrl}
        method="POST"
        target="android-waitlist-frame"
        data-waitlist-form
      >
        <label class="sr-only" for="android-waitlist-email">Email address</label>
        <input
          id="android-waitlist-email"
          class="waitlist-input"
          type="email"
          name={googleFormEmailEntry}
          placeholder="Email address"
          autocomplete="email"
          inputmode="email"
          required
          data-waitlist-email
        />
        <button class="waitlist-submit" type="submit">Join</button>
        <p class="waitlist-status" data-waitlist-status aria-live="polite"></p>
      </form>
      <iframe class="waitlist-frame" name="android-waitlist-frame" title="Android waitlist submission"></iframe>
    </div>
  </div>
</Layout>

<script>
  import stormHero from "../data/storm-hero-20261009.json";
  import { formatStormWindDetail, unitForCountryCode } from "../utils/wind-units.js";

  // Storm icons, tracks and callout leaders are drawn over the hero photo
  // rather than baked into it. Coordinates are pixels in the hero JPG, mapped
  // with the same cover + centre + scale(1.02) transform as .vista-hero-photo.
  const SVG_NS = "http://www.w3.org/2000/svg";
  const stormNames: Record<string, string> = {
    rachel: "Tropical Storm Rachel",
    isaias: "Hurricane Isaias",
    simon: "Hurricane Simon",
  };
  // The radar promo image is North American. Keep it for the Americas, and
  // use the Europe radar screenshot everywhere else when country lookup works.
  const AMERICAS_COUNTRY_CODES = new Set([
    "AG", "AI", "AR", "AW", "BB", "BL", "BM", "BO", "BQ", "BR", "BS", "BZ",
    "CA", "CL", "CO", "CR", "CU", "CW", "DM", "DO", "EC", "FK", "GD", "GF",
    "GL", "GP", "GS", "GT", "GY", "HN", "HT", "JM", "KN", "KY", "LC",
    "MF", "MQ", "MS", "MX", "NI", "PA", "PE", "PM", "PR", "PY", "SR", "SV",
    "SX", "TC", "TT", "US", "UY", "VC", "VE", "VG", "VI",
  ]);
  const activeCallouts = new Set(["rachel", "isaias"]);
  let automaticCountryCodePromise: Promise<string | null> | undefined;

  const detectAutomaticCountryCode = (): Promise<string | null> => {
    if (!automaticCountryCodePromise) {
      automaticCountryCodePromise = (async () => {
        const isGitHubPages = location.hostname.endsWith(".github.io");
        const endpoint = isGitHubPages ? "https://vistaweather.com/api/region" : "/api/region";
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 1500);
        try {
          const response = await fetch(endpoint, {
            headers: { Accept: "application/json" },
            cache: "no-store",
            credentials: "omit",
            signal: controller.signal,
          });
          if (!response.ok) return null;
          const data: unknown = await response.json();
          if (!data || typeof data !== "object" || !("countryCode" in data)) return null;
          const countryCode = (data as { countryCode?: unknown }).countryCode;
          return typeof countryCode === "string" ? countryCode : null;
        } catch {
          return null;
        } finally {
          window.clearTimeout(timeout);
        }
      })();
    }
    return automaticCountryCodePromise;
  };

  const renderWindSpeeds = (hero: HTMLElement, unit: "mph" | "kmh") => {
    hero.querySelectorAll<HTMLElement>("[data-wind-speed]").forEach((detail) => {
      const maxWindMph = Number(detail.dataset.maxWindMph);
      const movingSpeedMph = Number(detail.dataset.movingSpeedMph);
      if (!Number.isFinite(maxWindMph) || !Number.isFinite(movingSpeedMph)) return;
      detail.textContent = formatStormWindDetail({
        maxWindMph,
        direction: detail.dataset.direction ?? "",
        movingSpeedMph,
      }, unit);
    });
  };

  const renderCalloutTimes = (hero: HTMLElement) => {
    // Format the fixed source time, rather than converting it to the visitor's
    // time zone. Intl supplies the browser's default 12- or 24-hour cycle.
    const formatter = new Intl.DateTimeFormat(undefined, {
      hour: "numeric",
      minute: "2-digit",
      timeZone: "UTC",
    });
    hero.querySelectorAll<HTMLElement>("[data-clock-hour][data-clock-minute]").forEach((time) => {
      const hour = Number(time.dataset.clockHour);
      const minute = Number(time.dataset.clockMinute);
      if (!Number.isInteger(hour) || !Number.isInteger(minute)) return;
      time.textContent = formatter.format(new Date(Date.UTC(2000, 0, 1, hour, minute)));
    });
  };

  const initCountryPresentation = async (hero: HTMLElement) => {
    const countryCode = await detectAutomaticCountryCode();
    const unit = unitForCountryCode(countryCode);
    renderWindSpeeds(hero, unit);
    if (unit === "mph") {
      document.querySelectorAll<HTMLImageElement>("[data-us-image-src]").forEach((image) => {
        const usImageSrc = image.dataset.usImageSrc;
        if (usImageSrc) image.src = usImageSrc;
      });
    }

    const normalizedCountryCode = countryCode?.trim().toUpperCase();
    if (normalizedCountryCode && !AMERICAS_COUNTRY_CODES.has(normalizedCountryCode)) {
      document.querySelectorAll<HTMLImageElement>("[data-non-americas-image-src]").forEach((image) => {
        const nonAmericasImageSrc = image.dataset.nonAmericasImageSrc;
        if (nonAmericasImageSrc) image.src = nonAmericasImageSrc;
        const nonAmericasImageAlt = image.dataset.nonAmericasImageAlt;
        if (nonAmericasImageAlt) image.alt = nonAmericasImageAlt;
      });
    }
  };

  const svgElement = (name: string, attributes: Record<string, string | number>) => {
    const element = document.createElementNS(SVG_NS, name);
    for (const [key, value] of Object.entries(attributes)) element.setAttribute(key, String(value));
    return element;
  };

  const layoutStormMap = (hero: HTMLElement, map: HTMLElement, lines: SVGSVGElement) => {
    const width = hero.clientWidth;
    const height = hero.clientHeight;
    // Mirrors the hero's cover sizing, `center 30%` position and 1.02 scale.
    const cover = Math.max(width / stormHero.width, height / stormHero.height);
    const scale = cover * 1.02;
    const offsetX = (width - stormHero.width * scale) / 2;
    const offsetY = height / 2 + ((height - stormHero.height * cover) * 0.3 - height / 2) * 1.02;
    const project = ([x, y]: number[]) => [offsetX + x * scale, offsetY + y * scale];
    const toPath = (points: number[][]) =>
      points.map((point, index) => `${index ? "L" : "M"}${project(point).map((v) => v.toFixed(1)).join(" ")}`).join("");

    lines.setAttribute("viewBox", `0 0 ${width} ${height}`);
    lines.replaceChildren();

    const anchors: Record<string, number[]> = {};
    const endpoints: Record<string, number[]> = {};
    for (const storm of stormHero.storms) {
      const stormKey = storm.callout ?? storm.id.toLowerCase();
      const stormName = stormNames[stormKey] ?? "Tropical cyclone";
      lines.append(svgElement("path", { class: "storm-track-past", d: toPath(storm.past) }));
      lines.append(svgElement("path", { class: "storm-track-forecast", d: toPath(storm.forecast) }));
      const [endX, endY] = project(storm.forecast[storm.forecast.length - 1]);
      lines.append(svgElement("circle", { class: "storm-track-end", cx: endX, cy: endY, r: 5 }));

      const [x, y] = project(storm.current);
      let marker = map.querySelector<HTMLButtonElement>(`[data-storm-marker="${stormKey}"]`);
      if (!marker) {
        marker = document.createElement("button");
        marker.type = "button";
        marker.className = "storm-marker";
        marker.dataset.stormMarker = stormKey;
        marker.setAttribute("aria-controls", `storm-callout-${stormKey}`);
        marker.addEventListener("click", () => {
          if (activeCallouts.has(stormKey)) {
            activeCallouts.delete(stormKey);
          } else {
            activeCallouts.add(stormKey);
          }
          layoutStormMap(hero, map, lines);
        });
        map.append(marker);
      }
      marker.style.left = `${x}px`;
      marker.style.top = `${y}px`;
      marker.setAttribute("aria-expanded", String(activeCallouts.has(stormKey)));
      marker.setAttribute("aria-label", `${activeCallouts.has(stormKey) ? "Hide" : "Show"} details for ${stormName}`);
      if (storm.callout) {
        anchors[storm.callout] = [x, y];
        endpoints[storm.callout] = [endX, endY];
      }
    }

    // The two original cards appear on load. Each marker toggles only its own
    // callout, leaving the other storm details in their current state.
    const callouts = hero.querySelectorAll<HTMLElement>("[data-storm-callout]");
    callouts.forEach((card) => {
      card.hidden = !activeCallouts.has(card.dataset.stormCallout ?? "");
    });
    const visibleCallouts = Array.from(callouts).filter((card) => !card.hidden);
    if (!visibleCallouts.length || !visibleCallouts[0].getClientRects().length) return;
    const copyEl = hero.querySelector<HTMLElement>(".hero-copy");
    const copyHeading = copyEl?.querySelector<HTMLElement>("h1");
    const heroBox = hero.getBoundingClientRect();
    const copyRight = copyHeading
      ? copyHeading.getBoundingClientRect().right - heroBox.left
      : (copyEl ? copyEl.getBoundingClientRect().right - heroBox.left : 0);
    const gutter = 24;
    const markerGap = 22;

    for (const card of visibleCallouts) {
      const calloutKey = card.dataset.stormCallout ?? "";
      const anchor = anchors[calloutKey];
      if (!anchor) continue;
      const [x, y] = anchor;
      const cardWidth = card.offsetWidth;
      const cardHeight = card.offsetHeight;
      let left: number;
      let top: number;
      let leader: number[];

      if (calloutKey === "simon") {
        // Simon's card sits southwest of the southern marker, clear of the
        // cyclone icons and the hero copy.
        left = Math.max(gutter, Math.min(x - cardWidth - 28, width - cardWidth - gutter));
        top = Math.max(gutter, Math.min(y + markerGap + 8, height - cardHeight - gutter));
        leader = [x - markerGap + 2, y + 8, left + cardWidth, top + 18];
      } else if (calloutKey === "isaias" && x + 110 + cardWidth <= width - gutter) {
        left = x + 110;
        top = y - cardHeight / 2 + 18;
        leader = [x + markerGap, y + 4, left, top + cardHeight / 2];
      } else if (calloutKey === "isaias") {
        left = Math.min(Math.max(x - cardWidth * 0.48, copyRight + gutter), width - cardWidth - gutter);
        top = y - cardHeight - 64;
        leader = [x, y - markerGap, x, top + cardHeight];
      } else {
        // Rachel: place above her storm so the southern storm and all tracks stay visible.
        const endAnchor = endpoints[calloutKey];
        const maxTopFromTrack = endAnchor ? endAnchor[1] - cardHeight - 20 : y - cardHeight - 60;
        top = Math.max(gutter + 64, Math.min(y - cardHeight - 60, maxTopFromTrack));
        left = Math.min(Math.max(x - cardWidth * 0.4, copyRight + gutter), width - cardWidth - gutter);
        const leaderX = Math.max(left + 24, Math.min(x, left + cardWidth - 24));
        leader = [x, y - markerGap, leaderX, top + cardHeight];
      }

      card.style.inset = `${top}px auto auto ${left}px`;
      const [x1, y1, x2, y2] = leader;
      lines.append(svgElement("line", { class: "storm-leader", x1, y1, x2, y2 }));
    }
  };

  const initStormMap = () => {
    const map = document.querySelector<HTMLElement>("[data-storm-map]");
    const lines = map?.querySelector<SVGSVGElement>("[data-storm-lines]");
    const hero = map?.closest<HTMLElement>(".vista-hero");
    if (!map || !lines || !hero) return;
    const callouts = hero.querySelector<HTMLElement>(".storm-callouts");
    const layout = () => layoutStormMap(hero, map, lines);
    renderCalloutTimes(hero);
    layout();
    hero.querySelectorAll<HTMLElement>("[data-storm-callout]").forEach((card) => {
      if (card.dataset.stormInteractive === "true") return;
      const calloutKey = card.dataset.stormCallout ?? "";
      const stormName = stormNames[calloutKey] ?? "Tropical cyclone";
      card.dataset.stormInteractive = "true";
      card.setAttribute("role", "button");
      card.tabIndex = 0;
      card.setAttribute("aria-label", `Hide details for ${stormName}`);
      const hideCallout = () => {
        activeCallouts.delete(calloutKey);
        layout();
        map.querySelector<HTMLButtonElement>(`[data-storm-marker="${calloutKey}"]`)?.focus();
      };
      card.addEventListener("click", hideCallout);
      card.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        hideCallout();
      });
    });
    const countryPresentationReady = initCountryPresentation(hero);
    new ResizeObserver(layout).observe(hero);
    const revealCallouts = async () => {
      await countryPresentationReady;
      layout();
      callouts?.setAttribute("data-storm-ready", "");
    };
    if (document.fonts) document.fonts.ready.then(revealCallouts);
    else revealCallouts();
  };

  document.addEventListener("astro:page-load", initStormMap);
  if (document.readyState !== "loading") initStormMap();

  const openButton = document.querySelector("[data-waitlist-open]");
  const modal = document.querySelector("[data-waitlist-modal]");
  const closeButtons = document.querySelectorAll("[data-waitlist-close]");
  const form = modal?.querySelector("[data-waitlist-form]");
  const emailInput = modal?.querySelector("[data-waitlist-email]");
  const status = modal?.querySelector("[data-waitlist-status]");

  const closeModal = () => {
    modal?.setAttribute("hidden", "");
    document.body.classList.remove("waitlist-modal-open");
  };

  openButton?.addEventListener("click", () => {
    modal?.removeAttribute("hidden");
    document.body.classList.add("waitlist-modal-open");
    if (emailInput instanceof HTMLInputElement) {
      emailInput.focus();
    }
  });

  closeButtons.forEach((button) => {
    button.addEventListener("click", closeModal);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeModal();
    }
  });

  form?.addEventListener("submit", () => {
    if (status) {
      status.textContent = "Thanks, you are on the Android list.";
    }
  });

  const dataSourcesPanel = document.querySelector<HTMLElement>("[data-data-sources-panel]");
  const dataSourcesToggle = document.querySelector<HTMLButtonElement>("[data-data-sources-toggle]");

  dataSourcesToggle?.addEventListener("click", () => {
    if (!dataSourcesPanel) return;
    const isExpanded = dataSourcesToggle.getAttribute("aria-expanded") === "true";
    dataSourcesToggle.setAttribute("aria-expanded", String(!isExpanded));
    dataSourcesPanel.hidden = isExpanded;
    const label = dataSourcesToggle.querySelector("span");
    if (label) label.textContent = isExpanded ? "View Data Sources" : "Hide Data Sources";
  });

  const mapsDetailPanel = document.querySelector<HTMLElement>("[data-maps-detail-panel]");
  const mapsDetailToggle = document.querySelector<HTMLButtonElement>("[data-maps-detail-toggle]");

  mapsDetailToggle?.addEventListener("click", () => {
    if (!mapsDetailPanel) return;
    const isExpanded = mapsDetailToggle.getAttribute("aria-expanded") === "true";
    mapsDetailToggle.setAttribute("aria-expanded", String(!isExpanded));
    mapsDetailPanel.hidden = isExpanded;
  });
</script>
