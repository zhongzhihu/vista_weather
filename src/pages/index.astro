---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StoreBadge from "../components/StoreBadge.astro";
import sfNowcastRain from "../images/SF_nowcast_rain_C.png";
import thirtyDayWeatherForecastsCelsius from "../images/30-day-weather-forecasts-celsius.png";
import edenPrairieNowcast from "../images/Edenprairie_C_nowc.png";
import forecastComparison from "../images/forecast_comparison.png";
import garmischAlternatePredictions from "../images/Garmisch_alternate_predictions.png";
import "../styles/global.css";

const googleFormUrl = import.meta.env.PUBLIC_GOOGLE_FORM_URL;
const googleFormEmailEntry = import.meta.env.PUBLIC_GOOGLE_FORM_EMAIL_ENTRY;
const satellitePhoto = "/satellite-hero-20261009.jpg";

// Feature blocks, presented Acme-style: heading + descriptive text first,
// then a large phone screenshot below. Each block alternates the image side on
// wide screens and stacks text-over-image on mobile.
const features = [
  {
    title: "Minute-by-Minute Rain",
    copy: "See exactly when rain will start, stop, and how intense it will be — down to the minute, for the next 4 hours. Highly accurate with hyper-local precision.",
    image: edenPrairieNowcast,
    alt: "Vista Weather rain nowcast for Eden Prairie",
  },
  {
    title: "30-Day Forecast",
    copy: "Plan further ahead with daily trends all the way out to a month.",
    image: thirtyDayWeatherForecastsCelsius,
    alt: "Vista Weather 30 day weather forecasts in Celsius",
  },
  {
    title: "Forecast Comparison",
    copy: "Compare NWS, Apple Weather, Foreca, and other trusted sources side by side, so you can see where they agree and where they don't.",
    image: forecastComparison,
    alt: "Vista Weather forecast comparison",
  },
  {
    title: "Alternate Predictions",
    copy: "When the forecast is less certain, see the range of other possible outcomes instead of a single number.",
    image: garmischAlternatePredictions,
    alt: "Vista Weather alternate model predictions for Garmisch",
  },
];
---

<Layout>
  <main class="site-shell">
    <Header heroPhoto={satellitePhoto}>
      <div class="hero-content" id="app">
        <div class="hero-copy">
          <p class="hero-kicker">Forecasts. Maps. Storm Tracking.</p>
          <h1>All-in-One Weather App</h1>
          <p class="hero-dek">
            Accurate forecasts, powerful maps, and real-time storm tracking.
          </p>
          <div class="hero-actions">
            <StoreBadge kind="ios" soon={false} href="https://apps.apple.com/us/app/id6768575893" />
            <button class="waitlist-button" type="button" data-waitlist-open>
              <span>Join Android waitlist</span>
              <span class="waitlist-button-note">Expected Dec '26</span>
            </button>
          </div>
        </div>

        <div class="hero-phones" aria-label="Vista Weather phone mockups">
          <div class="phone-case phone-case-primary">
            <div class="phone-screen-placeholder">
              <img class="phone-screen-image" src={sfNowcastRain.src} alt="Vista Weather rain nowcast for San Francisco" loading="eager" />
            </div>
          </div>

        </div>
      </div>
      <div class="storm-map" data-storm-map role="group" aria-label="Interactive storm tracks">
        <svg class="storm-map-lines" data-storm-lines aria-hidden="true"></svg>
      </div>
      <!-- Simon's values reflect the latest NHC update available by 1900 UTC (3 PM EDT in New York) on Oct 9, 2026. -->
      <aside class="storm-callouts" aria-label="Storm trajectory details">
        <article class="storm-callout storm-callout-rachel" id="storm-callout-rachel" data-storm-callout="rachel" aria-label="Tropical Storm Rachel details">
          <p class="storm-callout-time">Fri, Oct 9 · 3:00 PM</p>
          <p class="storm-callout-name">Tropical Storm Rachel</p>
          <p class="storm-callout-detail">Max winds 50 mph · Moving NE at 5 mph</p>
        </article>
        <article class="storm-callout storm-callout-isaias" id="storm-callout-isaias" data-storm-callout="isaias" aria-label="Hurricane Isaias details">
          <p class="storm-callout-time">Fri, Oct 9 · 3:00 PM</p>
          <p class="storm-callout-name">Hurricane Isaias</p>
          <p class="storm-callout-detail">Max winds 120 mph · Moving N at 17 mph</p>
        </article>
        <article class="storm-callout storm-callout-simon" id="storm-callout-simon" data-storm-callout="simon" aria-label="Hurricane Simon details" hidden>
          <p class="storm-callout-time">Fri, Oct 9 · 3:00 PM</p>
          <p class="storm-callout-name">Hurricane Simon</p>
          <p class="storm-callout-detail">Max winds 100 mph · Moving NW at 2 mph</p>
        </article>
      </aside>
    </Header>

    <section class="features-section" id="features">
      <h2 class="features-title">Advanced Forecast Tools</h2>

      {features.map((feature) => (
        <article class="feature-block">
          <div class="feature-copy">
            <h3>{feature.title}</h3>
            <p>{feature.copy}</p>
          </div>
          <div class="feature-media" aria-hidden="true">
            <div class="phone-case phone-case-feature">
              <div class="phone-screen-placeholder">
                <img class="phone-screen-image" src={feature.image.src} alt={feature.alt} loading="lazy" />
              </div>
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="about-section" id="about">
      <div class="about-grid">
        <div class="about-col">
          <h2>Designed by a data scientist to deliver clear, powerful, and beautiful forecasts.</h2>
          <p>
            Stunning photography, hyper-local insights, and intuitive tools that help you plan every day with confidence.
          </p>
        </div>
        <div class="about-col">
          <h2>Wide variety of Forecast Sources</h2>
          <p>
            Vista Weather offers a wide variety of forecast sources. Choose between Foreca, Apple Weather, or official national weather bureaus: the National Weather Service (US), Deutscher Wetterdienst (DE), Météo-France, Japan Meteorological Agency, Bureau of Meteorology (AU), KNMI (NL), GeoSphere Austria, MeteoSwiss, SMHI (SE), MET Norway, and FMI (FI).
          </p>
        </div>
      </div>
    </section>

    <Footer />
  </main>

  <div class="waitlist-modal" data-waitlist-modal hidden>
    <button class="waitlist-backdrop" type="button" aria-label="Close Android waitlist form" data-waitlist-close></button>
    <div
      class="waitlist-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="android-waitlist-title"
    >
      <button class="waitlist-close" type="button" aria-label="Close Android waitlist form" data-waitlist-close>
        <span aria-hidden="true">&times;</span>
      </button>
      <h2 id="android-waitlist-title">Join Android waitlist</h2>
      <p>Enter your email and we will let you know when Vista Weather is ready for Android.</p>
      <form
        class="waitlist-form"
        action={googleFormUrl}
        method="POST"
        target="android-waitlist-frame"
        data-waitlist-form
      >
        <label class="sr-only" for="android-waitlist-email">Email address</label>
        <input
          id="android-waitlist-email"
          class="waitlist-input"
          type="email"
          name={googleFormEmailEntry}
          placeholder="Email address"
          autocomplete="email"
          inputmode="email"
          required
          data-waitlist-email
        />
        <button class="waitlist-submit" type="submit">Join</button>
        <p class="waitlist-status" data-waitlist-status aria-live="polite"></p>
      </form>
      <iframe class="waitlist-frame" name="android-waitlist-frame" title="Android waitlist submission"></iframe>
    </div>
  </div>
</Layout>

<script>
  import stormHero from "../data/storm-hero-20261009.json";

  // Storm icons, tracks and callout leaders are drawn over the hero photo
  // rather than baked into it. Coordinates are pixels in the hero JPG, mapped
  // with the same cover + centre + scale(1.02) transform as .vista-hero::before.
  const SVG_NS = "http://www.w3.org/2000/svg";
  const stormNames: Record<string, string> = {
    rachel: "Tropical Storm Rachel",
    isaias: "Hurricane Isaias",
    simon: "Hurricane Simon",
  };
  const activeCallouts = new Set(["rachel", "isaias"]);

  const svgElement = (name: string, attributes: Record<string, string | number>) => {
    const element = document.createElementNS(SVG_NS, name);
    for (const [key, value] of Object.entries(attributes)) element.setAttribute(key, String(value));
    return element;
  };

  const layoutStormMap = (hero: HTMLElement, map: HTMLElement, lines: SVGSVGElement) => {
    const width = hero.clientWidth;
    const height = hero.clientHeight;
    // Mirrors the hero's cover sizing, `center 30%` position and 1.02 scale.
    const cover = Math.max(width / stormHero.width, height / stormHero.height);
    const scale = cover * 1.02;
    const offsetX = (width - stormHero.width * scale) / 2;
    const offsetY = height / 2 + ((height - stormHero.height * cover) * 0.3 - height / 2) * 1.02;
    const project = ([x, y]: number[]) => [offsetX + x * scale, offsetY + y * scale];
    const toPath = (points: number[][]) =>
      points.map((point, index) => `${index ? "L" : "M"}${project(point).map((v) => v.toFixed(1)).join(" ")}`).join("");

    lines.setAttribute("viewBox", `0 0 ${width} ${height}`);
    lines.replaceChildren();

    const anchors: Record<string, number[]> = {};
    const endpoints: Record<string, number[]> = {};
    for (const storm of stormHero.storms) {
      const stormKey = storm.callout ?? storm.id.toLowerCase();
      const stormName = stormNames[stormKey] ?? "Tropical cyclone";
      lines.append(svgElement("path", { class: "storm-track-past", d: toPath(storm.past) }));
      lines.append(svgElement("path", { class: "storm-track-forecast", d: toPath(storm.forecast) }));
      const [endX, endY] = project(storm.forecast[storm.forecast.length - 1]);
      lines.append(svgElement("circle", { class: "storm-track-end", cx: endX, cy: endY, r: 5 }));

      const [x, y] = project(storm.current);
      let marker = map.querySelector<HTMLButtonElement>(`[data-storm-marker="${stormKey}"]`);
      if (!marker) {
        marker = document.createElement("button");
        marker.type = "button";
        marker.className = "storm-marker";
        marker.dataset.stormMarker = stormKey;
        marker.setAttribute("aria-label", `Toggle details for ${stormName}`);
        marker.setAttribute("aria-controls", `storm-callout-${stormKey}`);
        marker.addEventListener("click", () => {
          if (activeCallouts.has(stormKey)) {
            activeCallouts.delete(stormKey);
          } else {
            activeCallouts.add(stormKey);
          }
          layoutStormMap(hero, map, lines);
        });
        map.append(marker);
      }
      marker.style.left = `${x}px`;
      marker.style.top = `${y}px`;
      marker.setAttribute("aria-expanded", String(activeCallouts.has(stormKey)));
      if (storm.callout) {
        anchors[storm.callout] = [x, y];
        endpoints[storm.callout] = [endX, endY];
      }
    }

    // The two original cards appear on load. Each marker toggles only its own
    // callout, leaving the other storm details in their current state.
    const callouts = hero.querySelectorAll<HTMLElement>("[data-storm-callout]");
    callouts.forEach((card) => {
      card.hidden = !activeCallouts.has(card.dataset.stormCallout ?? "");
    });
    const visibleCallouts = Array.from(callouts).filter((card) => !card.hidden);
    if (!visibleCallouts.length || !visibleCallouts[0].getClientRects().length) return;
    const copyEl = hero.querySelector<HTMLElement>(".hero-copy");
    const copyHeading = copyEl?.querySelector<HTMLElement>("h1");
    const heroBox = hero.getBoundingClientRect();
    const copyRight = copyHeading
      ? copyHeading.getBoundingClientRect().right - heroBox.left
      : (copyEl ? copyEl.getBoundingClientRect().right - heroBox.left : 0);
    const gutter = 24;
    const markerGap = 22;

    for (const card of visibleCallouts) {
      const calloutKey = card.dataset.stormCallout ?? "";
      const anchor = anchors[calloutKey];
      if (!anchor) continue;
      const [x, y] = anchor;
      const cardWidth = card.offsetWidth;
      const cardHeight = card.offsetHeight;
      let left: number;
      let top: number;
      let leader: number[];

      if (calloutKey === "simon") {
        // Simon's card sits southwest of the southern marker, clear of the
        // cyclone icons and the hero copy.
        left = Math.max(gutter, Math.min(x - cardWidth - 28, width - cardWidth - gutter));
        top = Math.max(gutter, Math.min(y + markerGap + 8, height - cardHeight - gutter));
        leader = [x - markerGap + 2, y + 8, left + cardWidth, top + 18];
      } else if (calloutKey === "isaias" && x + 110 + cardWidth <= width - gutter) {
        left = x + 110;
        top = y - cardHeight / 2 + 18;
        leader = [x + markerGap, y + 4, left, top + cardHeight / 2];
      } else if (calloutKey === "isaias") {
        left = Math.min(Math.max(x - cardWidth * 0.48, copyRight + gutter), width - cardWidth - gutter);
        top = y - cardHeight - 64;
        leader = [x, y - markerGap, x, top + cardHeight];
      } else {
        // Rachel: place above her storm so the southern storm and all tracks stay visible.
        const endAnchor = endpoints[calloutKey];
        const maxTopFromTrack = endAnchor ? endAnchor[1] - cardHeight - 20 : y - cardHeight - 60;
        top = Math.max(gutter + 64, Math.min(y - cardHeight - 60, maxTopFromTrack));
        left = Math.min(Math.max(x - cardWidth * 0.4, copyRight + gutter), width - cardWidth - gutter);
        const leaderX = Math.max(left + 24, Math.min(x, left + cardWidth - 24));
        leader = [x, y - markerGap, leaderX, top + cardHeight];
      }

      card.style.inset = `${top}px auto auto ${left}px`;
      const [x1, y1, x2, y2] = leader;
      lines.append(svgElement("line", { class: "storm-leader", x1, y1, x2, y2 }));
    }
  };

  const initStormMap = () => {
    const map = document.querySelector<HTMLElement>("[data-storm-map]");
    const lines = map?.querySelector<SVGSVGElement>("[data-storm-lines]");
    const hero = map?.closest<HTMLElement>(".vista-hero");
    if (!map || !lines || !hero) return;
    const layout = () => layoutStormMap(hero, map, lines);
    layout();
    new ResizeObserver(layout).observe(hero);
    document.fonts?.ready.then(layout);
  };

  document.addEventListener("astro:page-load", initStormMap);
  if (document.readyState !== "loading") initStormMap();

  const openButton = document.querySelector("[data-waitlist-open]");
  const modal = document.querySelector("[data-waitlist-modal]");
  const closeButtons = document.querySelectorAll("[data-waitlist-close]");
  const form = modal?.querySelector("[data-waitlist-form]");
  const emailInput = modal?.querySelector("[data-waitlist-email]");
  const status = modal?.querySelector("[data-waitlist-status]");

  const closeModal = () => {
    modal?.setAttribute("hidden", "");
    document.body.classList.remove("waitlist-modal-open");
  };

  openButton?.addEventListener("click", () => {
    modal?.removeAttribute("hidden");
    document.body.classList.add("waitlist-modal-open");
    if (emailInput instanceof HTMLInputElement) {
      emailInput.focus();
    }
  });

  closeButtons.forEach((button) => {
    button.addEventListener("click", closeModal);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeModal();
    }
  });

  form?.addEventListener("submit", () => {
    if (status) {
      status.textContent = "Thanks, you are on the Android list.";
    }
  });
</script>
