---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StoreBadge from "../components/StoreBadge.astro";
import sfNowcastRain from "../images/SF_nowcast_rain_C.png";
import parisDryToday from "../images/paris dry today.png";
import thirtyDayWeatherForecastsCelsius from "../images/30-day-weather-forecasts-celsius.png";
import edenPrairieNowcast from "../images/Edenprairie_C_nowc.png";
import "../styles/global.css";

const googleFormUrl = import.meta.env.PUBLIC_GOOGLE_FORM_URL;
const googleFormEmailEntry = import.meta.env.PUBLIC_GOOGLE_FORM_EMAIL_ENTRY;
const sfPhoto =
  "https://images.unsplash.com/photo-1501594907352-04cda38ebc29?q=80&w=1632&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D";

const clarityCards = [
  {
    icon: "rain",
    title: "Will it rain?",
    copy: "See the chance of rain hour by hour with precise probability and intensity.",
  },
  {
    icon: "clock-purple",
    title: "When will it start?",
    copy: "Minute-by-minute timing so you can plan ahead with confidence.",
  },
  {
    icon: "clock-teal",
    title: "When will it stop?",
    copy: "Know when the rain clears so you can get on with your day.",
  },
  {
    icon: "shield",
    title: "How sure is the forecast?",
    copy: "Understand confidence levels behind every forecast we show.",
  },
];
---

<Layout>
  <main class="site-shell">
    <Header heroPhoto={sfPhoto}>
      <div class="hero-content" id="app">
        <div class="hero-copy">
          <p class="hero-kicker">See the weather through the beauty of each place</p>
          <h1>Accurate and Elegant Weather Forecasts</h1>
          <p class="hero-dek">
            Finally a powerful weather app that is both accurate and beautiful. 
          </p>
          <div class="hero-actions">
            <StoreBadge kind="ios" soon={false} href="https://apps.apple.com/us/app/id6768575893" />
            <button class="waitlist-button" type="button" data-waitlist-open>
              <span>Join Android waitlist</span>
              <span class="waitlist-button-note">Expected Sep '26</span>
            </button>
          </div>
        </div>

        <div class="hero-phones" aria-label="Vista Weather phone mockups">
          <div class="phone-case phone-case-primary">
            <div class="phone-screen-placeholder">
              <img class="phone-screen-image" src={sfNowcastRain.src} alt="Vista Weather rain nowcast for San Francisco" loading="eager" />
            </div>
          </div>
          <div class="phone-case phone-case-secondary">
            <div class="phone-screen-placeholder">
              <img class="phone-screen-image" src={parisDryToday.src} alt="Vista Weather dry today forecast for Paris" loading="eager" />
            </div>
          </div>
        </div>
      </div>
    </Header>

    <section class="clarity-section" id="features">
      <h2>Designed for accuracy</h2>
      <div class="clarity-grid">
        {clarityCards.map((card) => (
          <article class="clarity-card">
            <span class={`clarity-icon clarity-icon-${card.icon}`} aria-hidden="true">
              {card.icon === "rain" && (
                <svg viewBox="0 0 32 32">
                  <path d="M8 20c-3.1 0-5.2-2-5.2-4.7 0-2.6 2-4.6 4.7-4.7C8.5 6.9 11.6 4.5 15.6 4.5c4.5 0 7.9 3 8.3 7.2 2.9.5 5 2.7 5 5.5 0 3.1-2.4 5.3-5.8 5.3H8Z"></path>
                  <path d="m9 28 1.6-3.5M16 28l1.6-3.5M23 28l1.6-3.5"></path>
                </svg>
              )}
              {(card.icon === "clock-purple" || card.icon === "clock-teal") && (
                <svg viewBox="0 0 32 32">
                  <circle cx="16" cy="16" r="11.5"></circle>
                  <path d="M16 8.5V16l5.2 3.2"></path>
                </svg>
              )}
              {card.icon === "shield" && (
                <svg viewBox="0 0 32 32">
                  <path d="M16 4.5 26 8v7.3c0 6-4.1 10.2-10 12.2C10.1 25.5 6 21.3 6 15.3V8l10-3.5Z"></path>
                  <path d="m11.7 16 3.1 3.1 6-6.5"></path>
                </svg>
              )}
            </span>
            <h3>{card.title}</h3>
            <p>{card.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="local-section" id="photos">
      <div class="local-copy" id="about">
        <h2>Designed by a data scientist to deliver clear, powerful, and beautiful forecasts.</h2>
        <p>
          Stunning photography, hyper-local insights, and intuitive tools that help you plan every day with confidence.
        </p>

        <div class="local-feature-list">
          <div class="local-feature">
            <span class="local-feature-icon pin-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M12 21s7-6.2 7-12A7 7 0 1 0 5 9c0 5.8 7 12 7 12Z"></path>
                <circle cx="12" cy="9" r="2.5"></circle>
              </svg>
            </span>
            <div>
              <h3>Hyper-local rain</h3>
              <p>Minute-by-minute rain timing right where you are.</p>
            </div>
          </div>

          <div class="local-feature">
            <span class="local-feature-icon compare-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M8 18a5 5 0 1 1 3.9-8.1A5.5 5.5 0 1 1 18 17.8"></path>
                <path d="M5 19h6M13 19h6"></path>
              </svg>
            </span>
            <div>
              <h3>Forecast comparison</h3>
              <p>Compare multiple locations side by side.</p>
            </div>
          </div>

          <div class="local-feature">
            <span class="local-feature-icon widgets-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="4" y="4" width="6" height="6" rx="1.2"></rect>
                <rect x="14" y="4" width="6" height="6" rx="1.2"></rect>
                <rect x="4" y="14" width="6" height="6" rx="1.2"></rect>
                <rect x="14" y="14" width="6" height="6" rx="1.2"></rect>
              </svg>
            </span>
            <div>
              <h3>Beautiful widgets</h3>
              <p>Glanceable widgets designed for your Home Screen.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="local-phones" aria-label="Vista Weather additional phone mockups">
        <div class="phone-case phone-case-small">
          <div class="phone-screen-placeholder">
            <img class="phone-screen-image" src={edenPrairieNowcast.src} alt="Vista Weather nowcast for Eden Prairie" loading="lazy" />
          </div>
        </div>
        <div class="phone-case phone-case-small">
          <div class="phone-screen-placeholder">
            <img class="phone-screen-image" src={thirtyDayWeatherForecastsCelsius.src} alt="Vista Weather 30 day weather forecasts in Celsius" loading="lazy" />
          </div>
        </div>
        <div class="phone-case phone-case-small">
          <div class="phone-screen-placeholder"></div>
        </div>
      </div>
    </section>

    <Footer />
  </main>

  <div class="waitlist-modal" data-waitlist-modal hidden>
    <button class="waitlist-backdrop" type="button" aria-label="Close Android waitlist form" data-waitlist-close></button>
    <div
      class="waitlist-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="android-waitlist-title"
    >
      <button class="waitlist-close" type="button" aria-label="Close Android waitlist form" data-waitlist-close>
        <span aria-hidden="true">&times;</span>
      </button>
      <h2 id="android-waitlist-title">Join Android waitlist</h2>
      <p>Enter your email and we will let you know when Vista Weather is ready for Android.</p>
      <form
        class="waitlist-form"
        action={googleFormUrl}
        method="POST"
        target="android-waitlist-frame"
        data-waitlist-form
      >
        <label class="sr-only" for="android-waitlist-email">Email address</label>
        <input
          id="android-waitlist-email"
          class="waitlist-input"
          type="email"
          name={googleFormEmailEntry}
          placeholder="Email address"
          autocomplete="email"
          inputmode="email"
          required
          data-waitlist-email
        />
        <button class="waitlist-submit" type="submit">Join</button>
        <p class="waitlist-status" data-waitlist-status aria-live="polite"></p>
      </form>
      <iframe class="waitlist-frame" name="android-waitlist-frame" title="Android waitlist submission"></iframe>
    </div>
  </div>
</Layout>

<script>
  const openButton = document.querySelector("[data-waitlist-open]");
  const modal = document.querySelector("[data-waitlist-modal]");
  const closeButtons = document.querySelectorAll("[data-waitlist-close]");
  const form = modal?.querySelector("[data-waitlist-form]");
  const emailInput = modal?.querySelector("[data-waitlist-email]");
  const status = modal?.querySelector("[data-waitlist-status]");

  const closeModal = () => {
    modal?.setAttribute("hidden", "");
    document.body.classList.remove("waitlist-modal-open");
  };

  openButton?.addEventListener("click", () => {
    modal?.removeAttribute("hidden");
    document.body.classList.add("waitlist-modal-open");
    if (emailInput instanceof HTMLInputElement) {
      emailInput.focus();
    }
  });

  closeButtons.forEach((button) => {
    button.addEventListener("click", closeModal);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeModal();
    }
  });

  form?.addEventListener("submit", () => {
    if (status) {
      status.textContent = "Thanks, you are on the Android list.";
    }
  });
</script>
