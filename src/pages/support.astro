---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const supportEmail = "linguico.app@gmail.com";
---
<Layout
  title="Support — Vista Weather"
  description="Vista Weather support contact information."
>
  <main class="site-shell site-shell-text">
    <Header>
      <div class="hero-page">
        <p class="hero-kicker">Support</p>
        <h1>Support</h1>
        <p class="hero-page-lede">
          For Vista Weather support, email <a href={`mailto:${supportEmail}`}>{supportEmail}</a> and we will get back to you as soon as possible.
        </p>
      </div>
    </Header>

    <Footer />
  </main>
</Layout>
